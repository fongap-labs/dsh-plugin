{
  "schema_version": 1,
  "root": "packages",
  "artifact_name": "delta-code-release",
  "target_repository": "fongap-labs/plugins",
  "release_key": "delta-code",
  "release_name": "Delta Code",
  "release_notes": "",
  "license_expression": "MIT",
  "node_version_file": ".nvmrc",
  "python_version_file": "",
  "sbom_asset": "delta-code-sbom.cdx.json",
  "builds": [
    {
      "id": "portable",
      "runner_profile": "linux-standard",
      "target": "portable",
      "script": "delta-code/build-release.mjs",
      "assets": [
        "fongap-labs-delta-code.zip",
        "fongap-labs-delta-code.tgz"
      ],
      "attest_asset": "fongap-labs-delta-code.zip",
      "setup_rust": false
    }
  ],
  "changelog_entries": [
    "修复: 取消 Delta Code 对宿主工具包的精确运行时版本绑定，避免 Harness 候选版本误判插件不兼容。",
    "维护: 编程插件采用 Linux portable 构建流程，独立提供 zip 与 tgz 安装产物。"
  ]
}
