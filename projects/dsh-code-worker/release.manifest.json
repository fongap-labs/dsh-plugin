{
  "schema_version": 1,
  "root": "packages",
  "artifact_name": "dsh-code-worker-release",
  "target_repository": "fongap-labs/dsh-plugin",
  "release_key": "dsh-code-worker",
  "release_name": "Delta Code Worker",
  "release_notes": "",
  "license_expression": "Apache-2.0",
  "node_version_file": ".nvmrc",
  "python_version_file": "",
  "sbom_asset": "dsh-code-worker-sbom.cdx.json",
  "builds": [
    {
      "id": "portable",
      "runner_profile": "linux-standard",
      "target": "portable",
      "script": "dsh-code-worker/build-release.mjs",
      "assets": [
        "fongap-labs-dsh-code-worker.zip",
        "fongap-labs-dsh-code-worker.tgz"
      ],
      "attest_asset": "fongap-labs-dsh-code-worker.zip",
      "setup_rust": false
    }
  ],
  "changelog_entries": [
    "修复: 取消 Code Worker 对宿主工具包的精确运行时版本绑定，避免 Harness 候选版本误判插件不兼容。",
    "变更: 编程插件采用 Linux portable 构建流程，独立提供 zip 与 tgz 安装产物。"
  ]
}
