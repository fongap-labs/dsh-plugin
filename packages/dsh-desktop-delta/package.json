{
  "name": "@fongap-labs/dsh-desktop-delta",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Delta Desktop（Delta 桌面）：独立浏览器界面，由 DeepSeek Harness 提供 Agent 与会话",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client-entry.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
