{
  "name": "@dsh-plugin/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin monorepo internal shared library: defineTool wrapper, safe ctx.subprocess invocation, path resolution and sandbox validation",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./subprocess": {
      "types": "./lib/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "license": "MIT"
}
