{
  "name": "@fongap-labs/dsh-code-worker",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "DSH 编程插件：仓库分析、文件编辑、Git/Worktree、多 GitHub 账号、PR/CI 诊断和工程验证",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@fongap-labs/shared": "workspace:*"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "license": "Apache-2.0",
  "bundleDependencies": [
    "@fongap-labs/shared"
  ],
  "publishConfig": {
    "access": "public"
  }
}
