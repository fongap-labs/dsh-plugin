{
  "name": "@fongap-labs/dsh-code-worker",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Delta 编程助手（Delta Code Worker）：自动编程工作流、源码分析、文件编辑、Git、PR/CI 诊断与工程验证",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@fongap-labs/shared": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "license": "Apache-2.0",
  "bundleDependencies": [
    "@fongap-labs/shared"
  ],
  "publishConfig": {
    "access": "public"
  }
}
