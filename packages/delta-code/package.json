{
  "name": "@fongap-labs/delta-code",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Delta Code: task planning, code editing, Git workflows, LSP analysis, and project verification in Harness.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-session-panel"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@fongap-labs/shared": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "license": "MIT",
  "bundleDependencies": [
    "@fongap-labs/shared"
  ],
  "publishConfig": {
    "access": "public"
  }
}
