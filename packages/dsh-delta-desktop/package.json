{
  "name": "@fongap-labs/dsh-delta-desktop",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Delta Desktop native DeepSeek Harness plugin with extensible appearance and settings.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "COMPATIBILITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
