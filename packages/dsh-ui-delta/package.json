{
  "name": "dsh-ui-delta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness UI 界面深度美化与体验优化插件 (Delta UI)",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
